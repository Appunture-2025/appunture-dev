# ===========================================
# Appunture Frontend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# -----------------------------------------
# Firebase Configuration
# -----------------------------------------
# These can also be set in app.json > expo > extra
# Environment variables override app.json values
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# -----------------------------------------
# Google Sign-In Configuration
# -----------------------------------------
# Get these from Google Cloud Console > APIs & Services > Credentials
# https://console.cloud.google.com/apis/credentials
#
# 1. Create OAuth 2.0 Client IDs for:
#    - Web application (for Expo Go and web)
#    - Android (for Android builds)
#    - iOS (for iOS builds)
#
# 2. For the Web Client ID:
#    - Authorized JavaScript origins: https://auth.expo.io
#    - Authorized redirect URIs: https://auth.expo.io/@your-expo-username/appunture

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=

# -----------------------------------------
# API Configuration
# -----------------------------------------
EXPO_PUBLIC_API_BASE_URL=https://appunture-backend-756244484248.us-central1.run.app/api

# -----------------------------------------
# Feature Flags
# -----------------------------------------
EXPO_PUBLIC_ENABLE_STORAGE_UPLOAD=true
