{
  "expo": {
    "name": "Appunture",
    "slug": "appunture",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#007aff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appunture.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Appunture precisa de acesso à câmera para capturar imagens dos pontos de acupuntura.",
        "NSPhotoLibraryUsageDescription": "Appunture precisa de acesso à galeria para selecionar imagens dos pontos de acupuntura."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007aff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.appunture.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "appunture",
    "assetBundlePatterns": ["assets/**/*", "static/**/*"],
    "extra": {
      "apiBaseUrl": "https://appunture-backend-756244484248.us-central1.run.app/api",
      "firebaseApiKey": "AIzaSyA37SzSYX-_JAJsN6mw2X8hWDcXEiCMHog",
      "firebaseAuthDomain": "appunture-tcc.firebaseapp.com",
      "firebaseProjectId": "appunture-tcc",
      "firebaseStorageBucket": "appunture-tcc.appspot.com",
      "firebaseMessagingSenderId": "756244484248",
      "firebaseAppId": "1:756244484248:web:82482fed9b2b2f690d40ed",
      "firebaseMeasurementId": "",
      "firebaseDatabaseUrl": "https://appunture-tcc.firebaseio.com",
      "enableStorageUpload": true,
      "router": {
        "appRoot": "./app"
      },
      "eas": {
        "projectId": "864e35bc-9ecf-4e7a-866b-8507d1163044"
      }
    },
    "owner": "voidalzk",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/864e35bc-9ecf-4e7a-866b-8507d1163044"
    }
  }
